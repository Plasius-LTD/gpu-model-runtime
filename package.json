{
  "name": "@plasius/gpu-model-runtime",
  "version": "0.4.2",
  "description": "GPU model adapter discovery, loading orchestration, caching, and worker offload.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer > /dev/null 2>&1 || true",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "prepare": "npm run build",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage",
    "pack:check": "node scripts/verify-public-package.cjs",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "schema",
    "validation",
    "data-validation",
    "schema-validation",
    "typed-schema",
    "json-schema",
    "typescript",
    "typesafe",
    "runtime-validation",
    "type-safety",
    "plasius",
    "schema-helper",
    "entity-schema",
    "domain-modeling",
    "agnostic",
    "oss",
    "frontend",
    "backend",
    "portable",
    "scalability",
    "monorepo-friendly"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/gpu-model-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/gpu-model-runtime/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/gpu-model-runtime#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vite": "^8.3.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "overrides": {
    "nanoid": "3.3.18",
    "brace-expansion": "5.0.12",
    "esbuild": "0.28.1",
    "minimatch": "^11.0.9",
    "postcss": "8.5.23"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@plasius/asset-contracts": "0.8.3",
    "@plasius/gpu-model-core": "0.7.2"
  }
}
